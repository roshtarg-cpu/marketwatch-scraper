{
  "title": "MarketWatch Stock Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "stockSymbols": {
      "title": "Stock Symbols",
      "type": "array",
      "description": "List of stock ticker symbols to scrape (e.g., AAPL, GOOGL, MSFT)",
      "editor": "stringList",
      "prefill": ["AAPL", "GOOGL", "MSFT", "AMZN", "TSLA"],
      "example": ["AAPL", "GOOGL", "MSFT"]
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of stocks to scrape",
      "default": 50,
      "prefill": 10,
      "minimum": 1
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for scraping",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      },
      "editor": "proxy"
    }
  },
  "required": ["stockSymbols"]
}
