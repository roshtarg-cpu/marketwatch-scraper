{
  "actorSpecification": 1,
  "name": "marketwatch-scraper",
  "title": "MarketWatch Stock Scraper — Real-Time Quotes & News",
  "description": "Scrape real-time stock quotes, price changes, and latest financial news from MarketWatch.com. Get market data for any stock symbol with accurate pricing and related news headlines. Works with Claude, ChatGPT, and AI agents via Apify MCP.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Stock ticker symbol",
          "template": "{{{symbol}}}"
        },
        "companyName": {
          "type": "string",
          "description": "Company name",
          "template": "{{{companyName}}}"
        },
        "price": {
          "type": "string",
          "description": "Current stock price",
          "template": "{{{price}}}"
        },
        "change": {
          "type": "string",
          "description": "Price change in points",
          "template": "{{{change}}}"
        },
        "changePercent": {
          "type": "string",
          "description": "Price change percentage",
          "template": "{{{changePercent}}}"
        },
        "url": {
          "type": "string",
          "description": "Source URL",
          "template": "{{{url}}}"
        },
        "scrapedAt": {
          "type": "string",
          "description": "Timestamp",
          "template": "{{{scrapedAt}}}"
        }
      }
    }
  }
}
